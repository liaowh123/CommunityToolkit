<UserControl x:Class="CommunityToolkit示例.View.MainPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityToolkit示例.View"
             mc:Ignorable="d" 
            d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 卡片样式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数据表格样式 -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF8F9FA"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- 统计卡片样式 -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.05" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Margin="0,0,0,20" Padding="0,0,0,10" BorderBrush="#FFEEEEEE" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FF2C3E50">
                            <Run Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"/>
                            <Run Text=" 系统状态概览"/>
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5" Background="#FF2ECC71"/>
                            <TextBlock VerticalAlignment="Center">系统运行正常</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 统计卡片 -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 今日产量 -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="今日产量" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                            <TextBlock Text="1,234" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF2C3E50"
                                       Margin="0,5,0,5"/>
                            <TextBlock Text="件" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- 良品率 -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="良品率" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                            <TextBlock Text="99.2%" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF2ECC71"
                                       Margin="0,5,0,5"/>
                            <TextBlock Text="目标: 98.5%" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- 运行时间 -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="运行时间" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                            <TextBlock Text="8:24:16" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF2C3E50"
                                       Margin="0,5,0,5"/>
                            <TextBlock Text="小时:分钟:秒" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- 设备状态 -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="设备状态" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                            <TextBlock Text="4/5" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF2C3E50"
                                       Margin="0,5,0,5"/>
                            <TextBlock Text="正常/总数" 
                                       Foreground="#FF7F8C8D" 
                                       FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 设备连接状态 -->
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="设备连接状态" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,15"/>

                        <DataGrid Style="{StaticResource DataGridStyle}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="设备名称" Width="*" Binding="{Binding DeviceName}"/>
                                <DataGridTextColumn Header="类型" Width="120" Binding="{Binding Type}"/>
                                <DataGridTemplateColumn Header="连接状态" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="5" 
                                                        Background="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="最后通讯" Width="150" Binding="{Binding LastCommunication}"/>
                                <DataGridTextColumn Header="数据质量" Width="100" Binding="{Binding DataQuality}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
