<UserControl x:Class="CommunityToolkit示例.View.ReportStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityToolkit示例.View"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                         Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1C6EA4"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#FFE74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuccessButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#FF2ECC71"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF27AE60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题和按钮 -->
        <Border Grid.Row="0" Padding="10" Background="#ECF0F1" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50">
                        <Run Text="📊 "/>
                        <Run Text="生产报表统计"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📊 导出Excel" 
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0"/>
                    <Button Content="📄 导出PDF" 
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource DangerButtonStyle}" Margin="0,0,5,0"/>
                    <Button Content="🖨 打印" 
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 筛选条件 -->
        <Border Grid.Row="1" Padding="15" Background="White" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="统计周期" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="今日" IsChecked="{Binding IsTodaySelected}" Margin="0,0,10,0"/>
                            <RadioButton Content="本周" IsChecked="{Binding IsWeekSelected}" Margin="0,0,10,0"/>
                            <RadioButton Content="本月" IsChecked="{Binding IsMonthSelected}" Margin="0,0,10,0"/>
                            <RadioButton Content="自定义" IsChecked="{Binding IsCustomSelected}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="时间范围" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,10,0"/>
                            <TextBlock Text="到" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 统计卡片 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#3498DB" CornerRadius="5" Padding="20" Margin="5">
                <StackPanel>
                    <TextBlock Text="总产量" Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="{Binding TotalProduction}" Foreground="White" FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="件" Foreground="White" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#2ECC71" CornerRadius="5" Padding="20" Margin="5">
                <StackPanel>
                    <TextBlock Text="合格数" Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="{Binding QualifiedCount}" Foreground="White" FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="件" Foreground="White" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#E74C3C" CornerRadius="5" Padding="20" Margin="5">
                <StackPanel>
                    <TextBlock Text="不合格数" Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="{Binding UnqualifiedCount}" Foreground="White" FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="件" Foreground="White" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#F39C12" CornerRadius="5" Padding="20" Margin="5">
                <StackPanel>
                    <TextBlock Text="良品率" Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="{Binding YieldRate}" Foreground="White" FontSize="32" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="目标: 98.5%" Foreground="White" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 图表占位 -->
        <Border Grid.Row="3" Background="White" CornerRadius="5" Padding="40" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="产量趋势图" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="此处将显示产量随时间变化的折线图" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="White" CornerRadius="5" Padding="40" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="不良品分析图" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="此处将显示不良品原因的饼图或柱状图" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
